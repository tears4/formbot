{
  "maxPagesPerSite": 15,
  "maxFormsPerPage": 5,
  "maxLinksPerPage": 40,
  "maxCrawlDepth": 3,
  "navigationTimeout": 30000,
  "interactionTimeout": 15000,
  "submitWaitTimeout": 10000,
  "sameOriginOnly": true,
  "headless": true,
  "slowMo": 0,
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "userAgent": "Mozilla/5.0 (compatible; SmartFormQABot/1.0; +https://github.com/example/smart-form-qa-bot)",
  "priorityKeywords": [
    "contact",
    "contact-us",
    "contactus",
    "apply",
    "application",
    "register",
    "registration",
    "signup",
    "sign-up",
    "sign_up",
    "feedback",
    "support",
    "enquiry",
    "inquiry",
    "careers",
    "jobs",
    "request",
    "quote",
    "booking",
    "subscribe",
    "membership",
    "account",
    "application-form",
    "get-in-touch",
    "reach-us",
    "write-us",
    "talk-to-us"
  ],
  "formKeywords": [
    "form",
    "contact",
    "message",
    "enquiry",
    "inquiry",
    "feedback",
    "subscribe",
    "register",
    "signup",
    "apply"
  ],
  "successIndicators": [
    "thank you",
    "thanks",
    "success",
    "submitted",
    "received",
    "confirmation",
    "we will get back",
    "message sent",
    "successfully",
    "appreciate your"
  ],
  "errorIndicators": [
    "error",
    "invalid",
    "required",
    "please fill",
    "please enter",
    "must be",
    "failed",
    "try again",
    "captcha",
    "recaptcha"
  ],
  "captchaSelectors": [
    "iframe[src*='recaptcha']",
    "iframe[src*='hcaptcha']",
    ".g-recaptcha",
    "#recaptcha",
    "[data-sitekey]",
    ".h-captcha"
  ]
}
